# npm's global prefix lives in the home, because /usr/local is read-only here.
#
# This file is installed as ~/.config/npm/npmrc and reached through
# NPM_CONFIG_USERCONFIG. It is deliberately NOT ~/.npmrc: nvm refuses `nvm use`
# when ~/.npmrc (or NPM_CONFIG_PREFIX) sets a prefix, and the point is that
# `npm i -g <tool>` and `nvm use 20` both work with no helper and no flags.
#
# A tool installed here is on PATH (~/.npm-global/bin) and `agentbox home push`
# carries it to the base for new boxes.
prefix=${HOME}/.npm-global
